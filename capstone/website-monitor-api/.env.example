DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES="7d"
CRON_SECRET="replace-with-a-long-random-secret"

# Use "vertex" for a Google Cloud service account, "gemini" for a standard
# AIza Gemini Developer API key, or "mock" only for the local demo target.
AI_PROVIDER="vertex"
# Option A: Gemini Developer API (only standard AIza-format keys work)
GEMINI_API_KEY=""

# Option B: Vertex AI (use this for AQ.-format Google keys)
# Set both values together. Keep the service-account JSON on one line.
VERTEX_AI_PROJECT_ID=""
VERTEX_AI_LOCATION="us-central1"
VERTEX_AI_SERVICE_ACCOUNT_JSON=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional email notifications
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASS=""
